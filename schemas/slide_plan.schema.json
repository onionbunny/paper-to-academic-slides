{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-slide-skill/schemas/slide_plan.schema.json",
  "title": "Academic slide plan",
  "type": "object",
  "required": ["version", "case_id", "planner", "language", "constraints", "spine", "slides", "qa_prep", "uncertainty"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "case_id": {"type": "string"},
    "planner": {"type": "string", "enum": ["semantic", "deterministic_fallback"]},
    "language": {"type": "string", "enum": ["en", "zh"]},
    "constraints": {
      "type": "object",
      "required": ["audience", "audience_profile", "time_minutes", "max_slides", "talk_slides", "backup_slides", "seconds_per_slide"],
      "additionalProperties": true,
      "properties": {
        "audience": {"type": "string"},
        "audience_profile": {"type": "string", "enum": ["domain_expert", "mixed_seminar", "committee", "collaborator", "general"]},
        "time_minutes": {"type": "number", "minimum": 1},
        "max_slides": {"type": "integer", "minimum": 1},
        "talk_slides": {"type": "integer", "minimum": 1},
        "backup_slides": {"type": "integer", "minimum": 0},
        "seconds_per_slide": {"type": "number", "minimum": 1}
      }
    },
    "spine": {
      "type": "object",
      "required": ["problem", "gap", "approach", "key_evidence", "contributions", "limitations"],
      "additionalProperties": false,
      "properties": {
        "problem": {"type": "string"},
        "gap": {"type": "string"},
        "approach": {"type": "string"},
        "key_evidence": {"type": "array", "items": {"type": "string"}},
        "contributions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_no", "role", "backup", "title", "bullets", "figures", "tables", "evidence", "evidence_strength", "notes", "timing_seconds"],
        "additionalProperties": false,
        "properties": {
          "slide_no": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "enum": ["title", "background", "problem", "gap", "method", "mechanism", "result", "comparison", "contribution", "limitation", "conclusion", "divider", "backup"]},
          "backup": {"type": "boolean"},
          "title": {"type": "string", "minLength": 1, "maxLength": 110},
          "bullets": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["text", "level"],
              "additionalProperties": false,
              "properties": {
                "text": {"type": "string", "minLength": 1, "maxLength": 220},
                "level": {"type": "integer", "minimum": 0, "maximum": 2}
              }
            }
          },
          "figures": {"type": "array", "items": {"type": "string"}},
          "tables": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "page"],
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string", "enum": ["figure", "table", "page", "section", "abstract"]},
                "id": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "section": {"type": "string"},
                "quote": {"type": "string", "maxLength": 400}
              }
            }
          },
          "evidence_strength": {"type": "string", "enum": ["direct", "comparative", "mechanistic", "background"]},
          "notes": {"type": "string", "minLength": 20, "maxLength": 1200},
          "timing_seconds": {"type": "number", "minimum": 5},
          "source_label": {"type": "string"}
        }
      }
    },
    "qa_prep": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "question", "answer_points", "evidence"],
        "additionalProperties": false,
        "properties": {
          "category": {"type": "string", "enum": ["mechanism", "data", "controls", "limitation", "general"]},
          "question": {"type": "string", "minLength": 5},
          "answer_points": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "page"],
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string", "enum": ["figure", "table", "page", "section", "abstract"]},
                "id": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "maxLength": 400}
              }
            }
          },
          "backup_slide_no": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
