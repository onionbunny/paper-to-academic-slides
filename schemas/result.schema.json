{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-slide-skill/schemas/result.schema.json",
  "title": "Skill run result",
  "type": "object",
  "required": ["case_id", "skill", "status", "constraints", "artifacts", "evidence_map", "qa_prep", "sources", "uncertainty", "change_records", "limitations"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string"},
    "skill": {
      "type": "object",
      "required": ["name", "version", "planner", "started_at", "finished_at", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "planner": {"type": "string", "enum": ["semantic", "deterministic_fallback"]},
        "model_used": {"type": ["string", "null"]},
        "started_at": {"type": "string"},
        "finished_at": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "status": {"type": "string", "enum": ["complete", "partial", "blocked"]},
    "status_detail": {"type": "string"},
    "constraints": {
      "type": "object",
      "required": ["audience", "audience_profile", "time_minutes", "max_slides", "talk_slides", "backup_slides"],
      "additionalProperties": true,
      "properties": {
        "audience": {"type": "string"},
        "audience_profile": {"type": "string"},
        "time_minutes": {"type": "number"},
        "max_slides": {"type": "integer"},
        "talk_slides": {"type": "integer"},
        "backup_slides": {"type": "integer"}
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["deck_pptx", "deck_pdf", "previews_dir", "slide_plan", "evidence_map", "speaker_notes"],
      "additionalProperties": false,
      "properties": {
        "deck_pptx": {"type": "string"},
        "deck_pdf": {"type": ["string", "null"]},
        "previews_dir": {"type": "string"},
        "preview_pngs": {"type": "array", "items": {"type": "string"}},
        "slide_plan": {"type": "string"},
        "evidence_map": {"type": "string"},
        "speaker_notes": {"type": "string"}
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_no", "role", "title", "evidence", "verbatim_check"],
        "additionalProperties": false,
        "properties": {
          "slide_no": {"type": "integer", "minimum": 1},
          "backup": {"type": "boolean"},
          "role": {"type": "string"},
          "title": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "page"],
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string", "enum": ["figure", "table", "page", "section", "abstract"]},
                "id": {"type": "string"},
                "page": {"type": "integer", "minimum": 1},
                "section": {"type": "string"},
                "quote": {"type": "string"}
              }
            }
          },
          "verbatim_check": {"type": "string", "enum": ["verified", "paraphrased", "flagged", "no_claim"]}
        }
      }
    },
    "qa_prep": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "question", "answer_points", "backup_slide_no"],
        "additionalProperties": false,
        "properties": {
          "category": {"type": "string"},
          "question": {"type": "string"},
          "answer_points": {"type": "array", "items": {"type": "string"}},
          "backup_slide_no": {"type": ["integer", "null"]}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "kind", "sha256", "pages"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "role": {"type": "string", "enum": ["paper", "template", "starting_deck", "doc", "image", "data", "other"]},
          "kind": {"type": "string"},
          "sha256": {"type": "string"},
          "pages": {"type": "integer", "minimum": 0}
        }
      }
    },
    "rendering": {
      "type": "object",
      "required": ["engine", "fonts", "theme", "qa_findings"],
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string"},
        "fonts": {"type": "array", "items": {"type": "string"}},
        "theme": {"type": "string"},
        "qa_findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "change_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "stage", "action"],
        "additionalProperties": false,
        "properties": {
          "at": {"type": "string"},
          "stage": {"type": "string"},
          "action": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
